---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import portrait from "../assets/michael-gilsinan.png";
import musicSchoolMap from "../assets/music-school-map.png";
import musicSchoolInstruments from "../assets/music-school-instruments.png";
import stackVolume from "../assets/stack-volume-trend.png";
import stackCoach from "../assets/stack-coach.png";
import stackPlan from "../assets/stack-plan.png";
import praxisCalendar from "../assets/portfolio/praxis/demo-calendar-attended.png";
import praxisInsights from "../assets/portfolio/praxis/demo-notes-insights.png";

const LINKEDIN = "https://www.linkedin.com/in/michaelgilsinan";
const STACK_URL = "https://apps.apple.com/us/app/st-ck/id6768111057";

const projects = [
  {
    label: "2020 — present · Sitemetric",
    title: "Strategy and operations for a construction intelligence platform",
    text: "Sitemetric helps owners, general contractors, and subcontractors manage projects through real-time data, AI, and connected field operations. As Director of Strategic Projects, I report directly to the CEO and work with leaders across the company to set quarterly priorities, track results, and agree on who follows up. Earlier, as SVP of Customer Experience, I built the Customer Success and Support teams from the ground up and handed both to permanent leaders. I also partnered with our CTO to launch the company’s first centralized data platform.",
    meta: ["Strategy & operations", "Executive reporting", "Data infrastructure", "Applied AI"],
    links: [{ href: "https://www.sitemetric.com/", label: "Sitemetric" }],
    stats: [
      { value: "1.5M+", label: "Workers on the platform" },
      { value: "20,000+", label: "Contractors on the platform" },
      { value: "40", label: "States" },
    ],
    featured: true,
  },
  {
    label: "2010 — 2022 · Founder",
    title: "Fort Lee School of Music",
    text: "Opened Fort Lee School of Music during the second year of my undergraduate studies and grew it to two locations in Fort Lee, NJ, and New York, NY. The expansion included raising capital, hiring architects, and overseeing the full gut renovation and build-out of a street-level Manhattan retail space. At its peak, the school employed 30 teachers and staff, delivered more than 300 classes per week, and produced events at the DiMenna Center, Baruch College, and other venues. Revenue grew 59% from 2017 to 2019. During COVID-19, I led the move to online instruction—choosing the platform, training instructors, and coordinating with families—and the school delivered 1,214 virtual lessons.",
    meta: ["Founder", "Two locations", "30 staff", "300+ classes / week"],
    links: [{ href: "https://www.fortleemusicschool.com/", label: "Fort Lee School of Music" }],
    visuals: [
      {
        src: musicSchoolMap,
        alt: "Map of the New York / New Jersey metro area with orange markers showing where 1,419 students came from, clustered densely around Fort Lee and upper Manhattan.",
        caption: "Where they came from — 1,419 students across the NY / NJ metro.",
      },
      {
        src: musicSchoolInstruments,
        alt: "The same metro map with markers colored by instrument — piano, guitar, and voice the most common — led by 461 piano and 322 guitar students.",
        caption: "Enrollment spanned nine instruments, led by piano, guitar, voice, and violin.",
      },
    ],
  },
  {
    label: "Music technology · Web",
    title: "Praxis Stack",
    text: "Studio-management software for music schools and private studios, shaped by a decade of scheduling lessons, billing families, and paying teachers at Fort Lee School of Music. I designed and built it independently around one idea: attendance is the source of truth. Mark a lesson attended and the family's ledger, the teacher's pay, and the studio's reports all update from that single action. An AI feature reads instructor lesson notes to surface individual student insights and studio-wide trends; every finding links back to the original note, teachers can correct it, and each teacher sees only the students they teach. Today it supports the school’s continuing students and day-to-day operations.",
    meta: ["Solo designer & developer", "Scheduling & billing", "Payroll", "Applied AI"],
    links: [{ href: "https://www.praxisstack.com/", label: "praxisstack.com" }],
    screens: true,
    visuals: [
      {
        src: praxisCalendar,
        alt: "Praxis Stack weekly calendar of color-coded lessons; a selected lesson is marked attended and the charge appears in the family ledger panel.",
        caption: "Weekly calendar: one click posts the charge.",
      },
      {
        src: praxisInsights,
        alt: "A teacher's lesson note for a piano student beside AI-generated studio insights grouped into themes, students needing attention, and action items.",
        caption: "Studio-wide insights from lesson notes.",
      },
    ],
    note: "Screens are from the public demo, which uses a fictional sample studio.",
  },
  {
    label: "Weekend project · iOS",
    title: "Stack",
    text: "A strength-training app I built for myself to support my own workouts while practicing how to ship real products. Built with React Native and Expo, with a Railway backend, RevenueCat for subscriptions, Resend for transactional email, and Xcode for App Store submission. I’m not chasing user growth—the point is to keep exercising, building, launching, and maintaining something end to end.",
    meta: ["React Native", "Expo", "Railway", "RevenueCat", "Resend"],
    links: [{ href: STACK_URL, label: "View on App Store" }],
    gallery: [
      { src: stackPlan, alt: "Stack app — workout plan screen with a body map and per-day muscle checklist." },
      { src: stackCoach, alt: "Stack app — the built-in aiCoach answering a training question about rest between sets." },
      { src: stackVolume, alt: "Stack app — weekly volume trend for bench press with an expanded per-set history." },
    ],
  },
];

const background = [
  {
    text: "Started college as a performance major at a classical music conservatory in New York City, where I went on to earn bachelor’s and master’s degrees in classical guitar performance. By my second year, I had founded Fort Lee School of Music and was hiring classmates to teach. Over the next decade, it grew into a music and art school with locations in Fort Lee and New York City, including a street-level Manhattan storefront with its own community performance space. As a guitarist, I’ve performed at venues including the Sydney Opera House, Kennedy Center, National Theatre of Panama, Music Space Camerata in South Korea, Caesars Palace in Las Vegas, and the Smithsonian’s National Museum of Asian Art in Washington, D.C.",
    video: {
      id: "hAnhX6I9tAs",
      title: "Michael Gilsinan performing Cateretê by Sérgio Assad",
      caption: "Cateretê from Suite Brasileira No. 4 by Sérgio Assad, performed in the school's Manhattan space, SUPtown Music & Arts.",
      duration: "4:20",
    },
  },
  {
    text: "During the COVID shutdown, I returned to school for a second master’s degree: an M.S. in Applied Analytics with a concentration in Management from SUNY Empire State University, expected December 2026. I also completed Noble Desktop’s Python Data Science and Machine Learning certificate and its Python for Automation bootcamp.",
  },
  {
    text: "Joined Sitemetric in 2020 as a Data Control Officer and moved into running the company’s sensor fleet and data platform. Since then, I’ve served as Data Platform Director, SVP of Customer Experience, Senior Data Engineer, and now Director of Strategic Projects, reporting to the CEO.",
  },
];
---

<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />

  <main id="main">
    <div id="top" class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="mono eyebrow">Director, Strategic Projects · Sitemetric</p>
          <h1 id="hero-title" class="display">Michael Gilsinan</h1>
          <p class="lede">
            I’m a strategy and operations leader with 15+ years across technology and music education. Today I partner directly with the CEO of
            <a class="lede-link" href="https://www.sitemetric.com/" target="_blank" rel="noreferrer noopener">Sitemetric</a>,
            an AI-powered construction intelligence platform used on many of the country’s largest construction projects, turning operational data into decisions and building the systems behind them. Before that, I founded and scaled a music and arts school to two locations in uptown Manhattan and northern New Jersey, delivering
            more than 300 classes each week with a team of 30.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#work">
              See the work
              <span class="arrow" aria-hidden="true">→</span>
            </a>
{/*
            <a class="button secondary" href={STACK_URL} target="_blank" rel="noreferrer noopener">
              Stack on the App Store
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
*/}
            <a class="button secondary" href={LINKEDIN} target="_blank" rel="noreferrer noopener">
              LinkedIn
            </a>
          </div>
        </div>

        <figure class="portrait">
          <Image
            src={portrait}
            alt="Michael Gilsinan"
            widths={[280, 460, 720]}
            sizes="(max-width: 900px) 260px, 380px"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="mono">
            <span class="status-dot" aria-hidden="true"></span>
            New York, NY
          </figcaption>
        </figure>
      </section>

      <section class="section" id="work" aria-labelledby="work-title">
        <div class="section-head" data-reveal>
          <div>
            <p class="mono eyebrow">Work</p>
            <h2 id="work-title" class="headline">Four things worth pointing at.</h2>
          </div>
          <p class="section-index">01 / 03</p>
        </div>

        <div class="project-list">
          {
            projects.map((project) => (
              <article class={project.featured ? "project featured" : "project"} data-reveal>
                <div class="project-top">
                  <p class="project-label">{project.label}</p>
                </div>
                <div class="project-body">
                  <div>
                    <h3>{project.title}</h3>
                    <p>{project.text}</p>
                    <div class="project-links">
                      {project.links.map((link) => (
                        <a
                          class="project-link"
                          href={link.href}
                          target="_blank"
                          rel="noreferrer noopener"
                        >
                          {link.label}
                          <span class="arrow" aria-hidden="true">
                            ↗
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                  <div class="project-meta">
                    {project.meta.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </div>
                {project.stats && (
                  <dl class="project-stats">
                    {project.stats.map((stat) => (
                      <div class="project-stat">
                        <dt class="mono">{stat.label}</dt>
                        <dd>{stat.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {project.gallery && (
                  <div class="project-gallery">
                    {project.gallery.map((shot) => (
                      <figure class="shot">
                        <Image
                          src={shot.src}
                          alt={shot.alt}
                          widths={[240, 420]}
                          sizes="(max-width: 720px) 60vw, 240px"
                          loading="lazy"
                        />
                      </figure>
                    ))}
                  </div>
                )}
                {project.visuals && (
                  <div class:list={["project-visuals", { screens: project.screens }]}>
                    {project.visuals.map((visual) => (
                      <figure class="project-visual">
                        <Image
                          src={visual.src}
                          alt={visual.alt}
                          widths={project.screens ? [620, 840, 1240] : [420, 620, 840]}
                          sizes={project.screens ? "(max-width: 620px) 92vw, 620px" : "(max-width: 720px) 92vw, 420px"}
                          loading="lazy"
                        />
                        <figcaption class="mono">{visual.caption}</figcaption>
                      </figure>
                    ))}
                  </div>
                )}
                {project.note && <p class="project-note">{project.note}</p>}
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" id="background" aria-labelledby="background-title">
        <div class="section-head" data-reveal>
          <div>
            <p class="mono eyebrow">Background</p>
            <h2 id="background-title" class="headline">From founding a music school to partnering with a CEO on strategy, operations, and data.</h2>
          </div>
          <p class="section-index">02 / 03</p>
        </div>

        <div class="timeline">
          {
            background.map((item) => (
              <div class="timeline-item" data-reveal>
                <p>{item.text}</p>
                {item.video && <VideoEmbed {...item.video} />}
              </div>
            ))
          }
        </div>
      </section>

      <section class="section" id="contact" aria-labelledby="contact-title">
        <div class="section-head" data-reveal>
          <div>
            <p class="mono eyebrow">Contact</p>
          </div>
          <p class="section-index">03 / 03</p>
        </div>

        <div class="contact" data-reveal>
          <h2 id="contact-title" class="headline">Say hi.</h2>
          <p class="lede">
            Happy to talk about data, construction tech, running a services business, or
            anything I've shipped.
          </p>
          <div class="contact-actions">
            <a class="button primary" href={LINKEDIN} target="_blank" rel="noreferrer noopener">
              Connect on LinkedIn
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
