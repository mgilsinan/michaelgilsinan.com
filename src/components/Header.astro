---
interface Props {
  /** Where the Contact link goes; defaults to the homepage section. */
  contactHref?: string;
}

// Section links point at the homepage when the header is used on other pages.
const path = Astro.url.pathname;
const onHome = path === "/";
const home = onHome ? "" : "/";
const inPortfolio = path.startsWith("/portfolio");
const { contactHref = `${home}#contact` } = Astro.props;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={onHome ? "#top" : "/"} aria-label="Michael Gilsinan home">
      <span class="brand-mark" aria-hidden="true">MG</span>
      <span>Michael Gilsinan</span>
    </a>
    <div class="header-right">
      <nav class="nav-links" aria-label="Primary">
        <a href={`${home}#work`}>Work</a>
        <a class="nav-portfolio" href="/portfolio/" aria-current={inPortfolio ? "page" : undefined}>Portfolio</a>
        <a href={`${home}#background`}>Background</a>
        <a href={contactHref}>Contact</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to light theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>
    </div>
  </div>
</header>
