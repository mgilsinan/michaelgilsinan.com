---
import { LINKEDIN } from "../../data/site";
---

<section class="shell section pf-contact" id="contact" aria-labelledby="contact-title">
  <div class="contact" data-reveal>
    <p class="mono eyebrow">Contact</p>
    <h2 id="contact-title" class="headline">Let’s talk about music, experience, and technology.</h2>
    <p class="lede">
      Always glad to talk about creative work, live music, and products worth building.
    </p>
    <div class="contact-actions">
      <a class="button primary" href={LINKEDIN} target="_blank" rel="noreferrer noopener">
        Connect on LinkedIn
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="button secondary" href="/">
        michaelgilsinan.com
      </a>
    </div>
  </div>
</section>
